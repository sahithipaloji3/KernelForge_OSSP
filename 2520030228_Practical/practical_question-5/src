#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>
#include <time.h>
int main(){
int fd[2];
int data;
int items;
int start,end;
double  timetaken;
double efficiency;
pipe(fd);
start=clock();
if(fork()==0){
close(fd[1]);
printf("consumer \n");
for(int i=0;i<5;i++){
read(fd[0],&data,sizeof(data));
printf("consumed %d\n",data);
}
close(fd[0]);
}
else{
close(fd[0]);
printf("producer \n");
for(int i=1;i<=5;i++){
data=i*10;
write(fd[1],&data,sizeof(data));
printf("produced %d\n",data);
}
close(fd[1]);
wait(NULL);
end=clock();
timetaken=(double)(end-start)/CLOCKS_PER_SEC;
printf("communication time is %lf\n",timetaken);
for(int i=1;i<=5;i++){
efficiency=(double)i/timetaken;
printf("communication efficiency  %lf\n",efficiency);}
}
}

