#include <stdio.h>
#include <unistd.h>
#include <stdlib.h> //used for wait() and waitpid() system calls
#include <sys/wait.h>//used for exit() systemcall
int main()
{
int pid[3];//initialize 3 child
for(int i=0;i<3;i++){//loop which runs for 3 childs
pid[i]=fork();//creating 3 childs
if(pid[i]==0)//indicates a child proccess
{
printf("child %d pid=%d\n",i+1,getpid());
sleep(i+1);// giving a pause after every child
exit(0);//exisitng the standard input
}
wait(NULL);//waiting for one child
printf("parent  one child is completed with wait()\n");
waitpid(pid[2],NULL,0);//waiting using specific  pid
printf("parent :child 3 has completed with waitpid()\n");
wait(NULL);//waiting for alst child to complete
printf("parent: all thee child are done\n");
}
}

